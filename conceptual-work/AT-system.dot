graph {
  /*rankdir = LR;*/
  s [label = "Subject"];
  o [label = "Object"];
  c [label = "Community"];
  m [label = "Mediating artefact"];
  r [label = "Rules"];
  d [label =" Division of labour"];

  s -- o [ style=dashed ];
  s -- c [ color=gray ];
  s -- m [ color=gray ];
  s -- r [ color=gray ];
  s -- d [ color=gray ];
  
  c -- o [ style=dashed ];
  c -- m [ color=gray ];
  c -- r [ color=gray ];
  c -- d [ color=gray ];

  o -- m [ color=gray ];
  o -- d [ color=gray ];
  o -- r [ color=gray ];

}
  